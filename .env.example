# OpenAI-compatible LLM (DeepSeek):
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-v4-flash
# Higher quality: deepseek-v4-pro
# Production mock LLM path has been removed — LLM_API_KEY is required at runtime.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=deepseek-v4-flash
# true 时按 ops_playbooks.json 的 llm_model / cost_model 路由；默认 false，全局使用 LLM_MODEL
LLM_RESPECT_PLAYBOOK_MODEL=false
LLM_TIMEOUT_S=60
PIPELINE_TIMEOUT_S=90
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_ESCALATE_USER_ID=
FEISHU_API_BASE=https://open.feishu.cn/open-apis
DEMO_MODE=true
DIAGNOSTIC_AGENT=true
DIAGNOSTIC_MAX_STEPS=8
CORRECTION_WEBHOOK_URL=
COAGENT_PUBLIC_URL=http://localhost:8000
# agents/ 客户端上报 CoAgent 的基址（默认同 localhost:8000）
COAGENT_URL=http://localhost:8000
CLAUDE_BIN=
CLAUDE_TIMEOUT_S=120
CONTENT_BUDGET_YUAN_DAILY=20
CONTENT_COST_PER_1K_TOKENS=0.024
